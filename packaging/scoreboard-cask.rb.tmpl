# Cask template for acheris-labs/homebrew-tools (Casks/scoreboard.rb).
# Rendered by the release workflow with envsubst: VERSION and SHA_APP come
# from the release's notarized app zip.
#
# One artifact installs the whole product: the app owns the state and listens
# on the unix socket, and ships the compiled CLI inside the bundle - the
# `binary` stanza symlinks it onto PATH. Signed, notarized, stapled.
cask "scoreboard" do
  version "${VERSION}"
  sha256 "${SHA_APP}"

  url "https://github.com/acheris-labs/agent-scoreboard/releases/download/v#{version}/Scoreboard-#{version}.zip"
  name "Scoreboard"
  desc "Claude Code session scoreboard for the macOS menu bar"
  homepage "https://github.com/acheris-labs/agent-scoreboard"

  depends_on macos: :ventura

  app "Scoreboard.app"
  binary "#{appdir}/Scoreboard.app/Contents/Resources/scoreboard"

  # Restore the hooks in the config folders chosen in Settings, then open the
  # app. A fresh install has chosen none, so nothing is registered and the
  # app opens its Settings window to ask. `brew upgrade` is an uninstall plus
  # an install: uninstall strips the hooks, and this puts them back.
  postflight do
    system_command "#{appdir}/Scoreboard.app/Contents/Resources/scoreboard",
                   args: ["init", "--restore"], print_stderr: false
    system_command "/usr/bin/open", args: ["-a", "#{appdir}/Scoreboard.app"]
  end

  # Unregister the hooks from every config folder while the binary still
  # exists - after uninstall it is gone, and Claude Code would keep invoking a
  # command that isn't there. Only scoreboard's own entries are removed; other
  # hooks are untouched. The folder list is kept for the next install.
  uninstall_preflight do
    system_command "#{appdir}/Scoreboard.app/Contents/Resources/scoreboard",
                   args: ["init", "--remove"], print_stderr: false
  end

  # Both ids: 3.2.2 renamed com.chrismadden.scoreboard to net.acheris.scoreboard.
  uninstall quit: ["net.acheris.scoreboard", "com.chrismadden.scoreboard"]

  # `brew uninstall --zap scoreboard` is the full teardown: session state,
  # snapshot, hook log, and the list of config folders. The hooks themselves
  # are already unwound by uninstall_preflight.
  zap trash: [
        "~/.local/state/scoreboard",
        "~/Library/Caches/net.acheris.scoreboard",
        "~/Library/Preferences/net.acheris.scoreboard.plist",
        "~/Library/Caches/com.chrismadden.scoreboard",
        "~/Library/Preferences/com.chrismadden.scoreboard.plist",
      ]

  caveats <<~EOS
    Scoreboard is opening now - look for the stoplight icon in the menu bar
    (top-right of the screen). To connect it to Claude Code, open Settings
    from that menu and add your Claude config folder (~/.claude, plus one for
    each CLAUDE_CONFIG_DIR you use). Scoreboard adds its hooks to each
    folder's settings.json, backing it up first; uninstalling removes them.

    Start a Claude session and it appears on the board. Clicking a session
    jumps to its terminal tab.
  EOS
end
